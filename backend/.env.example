# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit real credentials.

# Gmail account used to send approval/rejection/reset emails.
# Use a Gmail "app password", not your normal account password.
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password

# Used to sign QR codes for the Gatekeeper scanner. Any long
# random string — generate one, don't reuse this placeholder.
QR_SECRET=change-this-to-a-long-random-string

# The Admin Portal's shared login (see ADMIN_PORTAL_GUIDE.md).
# If left unset, a fallback in backend/config/adminCredentials.js
# is used instead — change that fallback if you skip this.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-your-own-password
